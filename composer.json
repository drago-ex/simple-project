{
	"name": "drago-ex/simple-project",
	"type": "project",
	"description": "Basic project for creating single-page sites with Drago Simple.",
	"authors": [
		{
			"name": "Zdeněk Papučík",
			"homepage": "https://github.com/accgit"
		}
	],
	"require": {
		"php": ">=8.3 <9",
		"tracy/tracy": "^2.7",
		"drago-ex/simple": "^2.0",
		"drago-ex/project-docker": "^2.0"
	},
	"require-dev": {
		"phpstan/phpstan-nette": "^2.0",
		"drago-ex/project-tools": "^1.0"
	},
	"autoload": {
		"psr-4": {"App\\": "app"}
	},
	"extra": {
		"drago-tools": {
			"vendor-names": ["drago-ex"],
			"allow-library-install": true
		}
	},
	"scripts": {
		"phpstan": "phpstan analyse",
		"post-install-cmd": [
			"drago-install",
			"drago-clean"
		],
		"post-update-cmd": [
			"drago-install",
			"drago-clean"
		]
	}
}

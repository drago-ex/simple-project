{
	"name": "simple-project",
	"scripts": {
		"docker:build": "docker compose build --no-cache",
		"docker:dev": "docker compose up -d --build && docker compose watch --no-up",
		"docker:production": "docker compose --env-file docker/.env.production up -d --build",
		"docker:down": "docker compose down --remove-orphans"
	}
}
